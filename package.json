{
  "name": "@pathly/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for the Pathly public /v1 API",
  "license": "Apache-2.0",
  "author": {
    "name": "Simon Raynaud / keyral"
  },
  "contributors": [
    "Pathly <devs@pathlyhq.com>"
  ],
  "homepage": "https://pathlyhq.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pathlyhq/pathly-sdk-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/pathlyhq/pathly-sdk-typescript/issues"
  },
  "keywords": [
    "pathly",
    "pathlyhq",
    "monitoring",
    "synthetic-monitoring",
    "saas",
    "sla",
    "sdk",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "README.fr.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "prepublishOnly": "npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^3.0.9",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
